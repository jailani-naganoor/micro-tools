{
  "name": "micro-tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:wd": "npm run dev -w @micro/working-days",
    "dev:dt": "npm run dev -w @micro/device-test",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run && TZ=Pacific/Kiritimati vitest run && TZ=America/Los_Angeles vitest run",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "lighthouse": "node scripts/lighthouse.mjs",
    "images": "node scripts/generate-images.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "chrome-launcher": "1.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
