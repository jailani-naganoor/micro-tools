---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { SiteConfig } from '../lib/types';

interface Props {
  site: SiteConfig;
}
const { site } = Astro.props;
---

<BaseLayout
  site={site}
  title={`Page not found | ${site.name}`}
  description="The page you were looking for could not be found."
  path="/404/"
  noindex
>
  <div class="container-page py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-prose">Sorry, we couldn’t find that page. It may have moved, or the address may be mistyped.</p>
    <p class="mt-6"><a class="btn btn-primary" href="/">Go to the {site.name}</a></p>
  </div>
</BaseLayout>
