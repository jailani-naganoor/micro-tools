---
import type { SiteConfig } from '../lib/types';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  site: SiteConfig;
}
const { site } = Astro.props;
const current = Astro.url.pathname;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
];
---

<header class="border-b border-line">
  <div class="container-page flex min-h-14 items-center justify-between gap-4 py-2">
    <a href="/" class="text-base font-bold text-fg no-underline sm:text-lg">{site.name}</a>
    <nav aria-label="Main" class="flex items-center gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-fg no-underline hover:bg-surface"
            aria-current={current.startsWith(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
