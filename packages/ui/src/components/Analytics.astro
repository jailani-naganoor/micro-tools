---
// Cloudflare Web Analytics (cookieless). Only rendered when PUBLIC_CF_ANALYTICS_TOKEN is set.
interface Props {
  token: string;
}
const { token } = Astro.props;
---

<script
  is:inline
  defer
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon={JSON.stringify({ token })}></script>
