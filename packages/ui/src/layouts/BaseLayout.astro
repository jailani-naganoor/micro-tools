---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdsLoader from '../components/AdsLoader.astro';
import Analytics from '../components/Analytics.astro';
import CookieSettings from '../components/CookieSettings.astro';
import { absoluteUrl, breadcrumbLd, organizationLd } from '../lib/seo';
import type { Crumb, SiteConfig } from '../lib/types';

interface Props {
  site: SiteConfig;
  /** Full page title (keep under 60 characters). */
  title: string;
  /** Meta description (keep under 155 characters). */
  description: string;
  /** Path of this page, e.g. "/about/". */
  path: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  /** Inner pages pass their trail; the home page omits it. */
  breadcrumbs?: Crumb[];
  noindex?: boolean;
}

const { site, title, description, path, ogType = 'website', jsonLd = [], breadcrumbs, noindex = false } =
  Astro.props;
const canonical = absoluteUrl(site, path);
const ogImage = absoluteUrl(site, '/og.png');
const structured = [organizationLd(site), ...(breadcrumbs ? [breadcrumbLd(site, breadcrumbs)] : []), ...jsonLd];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Sets the colour theme before first paint and adds noindex on *.pages.dev previews. -->
    <script is:inline src="/head.js"></script>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={site.themeColor.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={site.themeColor.dark} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {structured.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
    {site.env.adsEnabled && <AdsLoader client={site.env.adsenseClient} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only-focusable absolute top-2 left-2 z-50 rounded bg-bg px-3 py-2">Skip to content</a>
    <Header site={site} />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} />
    <CookieSettings site={site} />
    {site.env.cfAnalyticsToken && <Analytics token={site.env.cfAnalyticsToken} />}
  </body>
</html>
