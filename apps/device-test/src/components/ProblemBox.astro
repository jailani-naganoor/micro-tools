---
// Error box shown when microphone/camera access fails, with fix steps per browser.
interface Props {
  kind: 'microphone' | 'camera';
  id: string;
}
const { kind, id } = Astro.props;
const Kind = kind === 'microphone' ? 'Microphone' : 'Camera';
---

<div id={id} class="rounded-lg border-2 border-danger bg-bg p-4" role="alert" hidden>
  <h3 class="font-bold text-danger" data-problem-title></h3>
  <p class="mt-1" data-problem-message></p>
  <div data-permission-help class="mt-3 text-sm">
    <p class="font-semibold">How to allow {kind} access</p>
    <details class="mt-2">
      <summary class="cursor-pointer py-1 font-semibold">Chrome (Windows, Mac, Linux, ChromeOS)</summary>
      <ol class="mt-1 list-decimal space-y-1 pl-5">
        <li>Click the site controls icon to the left of the address bar.</li>
        <li>Turn on or set <strong>{Kind}</strong> to <strong>Allow</strong>.</li>
        <li>Reload the page and try again.</li>
      </ol>
    </details>
    <details class="mt-1">
      <summary class="cursor-pointer py-1 font-semibold">Microsoft Edge</summary>
      <ol class="mt-1 list-decimal space-y-1 pl-5">
        <li>Click the lock icon to the left of the address bar, then <strong>Permissions for this site</strong>.</li>
        <li>Set <strong>{Kind}</strong> to <strong>Allow</strong>.</li>
        <li>Reload the page and try again.</li>
      </ol>
    </details>
    <details class="mt-1">
      <summary class="cursor-pointer py-1 font-semibold">Firefox</summary>
      <ol class="mt-1 list-decimal space-y-1 pl-5">
        <li>Click the crossed-out {kind} icon in the address bar.</li>
        <li>Remove the <strong>Blocked</strong> permission by clicking the <strong>×</strong> next to it.</li>
        <li>Reload the page, try again and choose <strong>Allow</strong>.</li>
      </ol>
    </details>
    <details class="mt-1">
      <summary class="cursor-pointer py-1 font-semibold">Safari on Mac</summary>
      <ol class="mt-1 list-decimal space-y-1 pl-5">
        <li>Choose <strong>Safari › Settings</strong>, then the <strong>Websites</strong> tab.</li>
        <li>Select <strong>{Kind}</strong> and set this website to <strong>Allow</strong> or <strong>Ask</strong>.</li>
        <li>Reload the page and try again.</li>
      </ol>
    </details>
    <details class="mt-1">
      <summary class="cursor-pointer py-1 font-semibold">Safari on iPhone or iPad</summary>
      <ol class="mt-1 list-decimal space-y-1 pl-5">
        <li>
          Open the <strong>Settings</strong> app, then <strong>Safari</strong> (on recent versions: <strong
            >Apps › Safari</strong
          >).
        </li>
        <li>Under <strong>Settings for Websites</strong>, tap <strong>{Kind}</strong> and choose <strong>Ask</strong> or <strong>Allow</strong>.</li>
        <li>Return to Safari, reload the page and try again.</li>
      </ol>
    </details>
    <details class="mt-1">
      <summary class="cursor-pointer py-1 font-semibold">Chrome on Android</summary>
      <ol class="mt-1 list-decimal space-y-1 pl-5">
        <li>Tap the icon to the left of the address bar, then <strong>Permissions</strong>.</li>
        <li>Turn on <strong>{Kind}</strong>.</li>
        <li>
          If it is still blocked, open Android <strong>Settings › Apps › Chrome › Permissions</strong> and allow the
          {kind}.
        </li>
      </ol>
    </details>
    <details class="mt-1">
      <summary class="cursor-pointer py-1 font-semibold">Still blocked? Check your system settings</summary>
      <ul class="mt-1 list-disc space-y-1 pl-5">
        <li>
          <strong>Windows 11:</strong> Settings › Privacy &amp; security › {Kind} — turn on access for apps and for your
          browser.
        </li>
        <li>
          <strong>macOS:</strong> System Settings › Privacy &amp; Security › {Kind} — turn on your browser, then restart
          it.
        </li>
        <li>Work or school devices may block access through policy — ask your IT team.</li>
      </ul>
    </details>
  </div>
</div>
