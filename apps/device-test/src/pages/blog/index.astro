---
import BlogIndexPage from '@micro/ui/components/BlogIndexPage.astro';
import { getPublishedPosts } from '@micro/ui/lib/blog';
import { site } from '../../site.config';

const posts = await getPublishedPosts(site.env.showDrafts);
---

<BlogIndexPage
  site={site}
  posts={posts}
  description="Practical guides to fixing microphones, webcams, keyboards and screens on any computer or phone."
/>
