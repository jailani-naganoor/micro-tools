---
import { render } from 'astro:content';
import BlogPostLayout from '@micro/ui/layouts/BlogPostLayout.astro';
import { getPublishedPosts, type BlogPost } from '@micro/ui/lib/blog';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPublishedPosts(site.env.showDrafts);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
---

<BlogPostLayout site={site} post={post}>
  <Content />
</BlogPostLayout>
