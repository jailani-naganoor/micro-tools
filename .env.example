# Copy to apps/<site>/.env for local development, or set in Cloudflare Pages
# (Settings → Environment variables). All are optional; defaults are safe.

# Canonical origin for this site, no trailing slash. Used for canonical URLs,
# Open Graph URLs, sitemap.xml and robots.txt.
SITE_URL=https://working-days.example.com

# Link to the community site shown under the tool.
COMMUNITY_URL=https://community.example.com

# Links to the sibling tool sites (each site links to the other).
WORKING_DAYS_URL=https://working-days.example.com
DEVICE_TEST_URL=https://device-test.example.com

# Contact address shown on /contact and in the privacy policy.
CONTACT_EMAIL=hello@example.com

# Name of the person or business that runs the sites (copyright line, JSON-LD, legal pages).
PUBLISHER_NAME=Micro Tools

# Show blog posts marked draft: true (for local review only — never in production).
SHOW_DRAFTS=false

# ---- Ads (off by default) ----
# When false, no ad script is loaded and no ad space is reserved.
PUBLIC_ADS_ENABLED=false
# Your AdSense publisher ID, e.g. ca-pub-0000000000000000
PUBLIC_ADSENSE_CLIENT=
# Optional AdSense ad unit IDs for each placement.
PUBLIC_ADSENSE_SLOT_RESULT=
PUBLIC_ADSENSE_SLOT_CONTENT=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ---- Analytics (off by default) ----
# Cloudflare Web Analytics site token. Nothing loads when empty.
PUBLIC_CF_ANALYTICS_TOKEN=
